<!--
  Loaded at runtime by MainView (XamlReader), so there is no code-behind:
  elements are looked up by x:Name and events are wired in MainView.cs.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dead Man's Switch" Width="404" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#FFECEEF2"/>
    <SolidColorBrush x:Key="Muted" Color="#FF8B909A"/>
    <SolidColorBrush x:Key="Field" Color="#FF262931"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#FF363A44"/>
    <SolidColorBrush x:Key="Green" Color="#FF2ECC71"/>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FF0B2415"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="#FF2ECC71" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FF45D883"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FF27AE60"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Title-bar buttons; content is a Segoe MDL2 Assets glyph. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bg" Background="{StaticResource Field}" BorderBrush="{StaticResource FieldBorder}"
                    BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="#FF2ECC71"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented choice for the end action. -->
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Background="{StaticResource Field}" BorderBrush="{StaticResource FieldBorder}"
                    BorderThickness="1" CornerRadius="8" Height="34" Margin="2,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#FF1C3A29"/>
                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF2ECC71"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="{StaticResource Field}"
                      BorderBrush="{StaticResource FieldBorder}" BorderThickness="1">
                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                           Foreground="#FF0B2415" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#FF2ECC71"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#FF2ECC71"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
  </Window.Resources>

  <!-- The shadow sits on its own border so the effect doesn't soften the text. -->
  <Grid Margin="14">
    <Border CornerRadius="16" Background="#FF16181D">
      <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.5" Color="Black"/></Border.Effect>
    </Border>
    <Border x:Name="Root" CornerRadius="16" BorderBrush="#FF2A2D35" BorderThickness="1" Padding="18,12,18,18">
      <StackPanel>

        <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,-8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="AppIcon" Width="18" Height="18"/>
            <TextBlock Text="Dead Man's Switch" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="11"
                       Margin="6,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"/>
            <Button x:Name="MinBtn" Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize"/>
            <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Stop timer and close"/>
          </StackPanel>
        </Grid>

        <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#FF1D2A3B" CornerRadius="10"
                Padding="12,8" Margin="0,10,0,0">
          <Grid>
            <TextBlock x:Name="UpdateText" Foreground="{StaticResource Text}" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,90,0"/>
            <Button x:Name="UpdateBtn" Style="{StaticResource PrimaryButton}" Content="Update" FontSize="12"
                    Width="80" Height="28" HorizontalAlignment="Right"/>
          </Grid>
        </Border>

        <!-- Both panels share one cell; the hidden one still reserves its
             size, so the window doesn't jump when switching. -->
        <Grid>
          <StackPanel x:Name="MainPanel">
            <Grid Width="232" Height="232" Margin="0,22,0,14">
              <Ellipse Stroke="#FF262931" StrokeThickness="14"/>
              <Path x:Name="RingArc" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TimeText" Foreground="{StaticResource Text}" FontSize="50" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="TimeLabel" Foreground="{StaticResource Muted}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,-2,0,0"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Button x:Name="ExtendBtn" Style="{StaticResource PrimaryButton}" Content="I'm here" Height="52"/>
            <Button x:Name="StopBtn" Style="{StaticResource GhostButton}" Content="Stop timer and close"
                    Height="34" Margin="0,8,0,0"/>
          </StackPanel>

          <StackPanel x:Name="SettingsPanel" Visibility="Hidden">
            <TextBlock Text="Settings" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,2"/>

            <TextBlock Text="Check every" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="CheckMinBox" Width="84" TextAlignment="Center"/>
              <TextBlock Text="minutes" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Final warning" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="WarnSecBox" Width="84" TextAlignment="Center"/>
              <TextBlock Text="seconds" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock Text="When time runs out" Style="{StaticResource FieldLabel}"/>
            <UniformGrid Columns="3" Margin="-2,0">
              <RadioButton x:Name="ShutdownOpt" GroupName="EndAction" Content="Shut down"/>
              <RadioButton x:Name="RestartOpt" GroupName="EndAction" Content="Restart"/>
              <RadioButton x:Name="HibernateOpt" GroupName="EndAction" Content="Hibernate"/>
            </UniformGrid>

            <CheckBox x:Name="SoundBox" Content="Play a sound at the final warning" Margin="0,18,0,0"/>
            <CheckBox x:Name="UpdatesBox" Content="Check for updates when the app opens" Margin="0,10,0,0"/>

            <TextBlock x:Name="SettingsMsg" Foreground="#FFF08A7E" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="BackBtn" Style="{StaticResource GhostButton}" Content="Cancel" Height="40"/>
              <Button x:Name="SaveBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Save" Height="40" FontSize="14"/>
            </Grid>
          </StackPanel>
        </Grid>

      </StackPanel>
    </Border>
  </Grid>
</Window>
