<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeadMansSwitch.App"
             RequestedThemeVariant="Dark"
             Name="Dead Man's Switch">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Fluent derives checkbox, focus and selection colours from the accent. -->
      <Color x:Key="SystemAccentColor">#2ECC71</Color>
      <Color x:Key="SystemAccentColorDark1">#27AE60</Color>
      <Color x:Key="SystemAccentColorDark2">#1E8F4E</Color>
      <Color x:Key="SystemAccentColorDark3">#16703C</Color>
      <Color x:Key="SystemAccentColorLight1">#45D883</Color>
      <Color x:Key="SystemAccentColorLight2">#6BE29C</Color>
      <Color x:Key="SystemAccentColorLight3">#94EBB8</Color>

      <!-- Bundled so the app looks the same on every system. -->
      <FontFamily x:Key="AppFont">avares://DeadMansSwitch/Assets/Fonts#Inter</FontFamily>

      <SolidColorBrush x:Key="TextBrush" Color="#ECEEF2"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#8B909A"/>
      <SolidColorBrush x:Key="FieldBrush" Color="#262931"/>
      <SolidColorBrush x:Key="FieldBorderBrush" Color="#363A44"/>
      <SolidColorBrush x:Key="GreenBrush" Color="#2ECC71"/>
      <SolidColorBrush x:Key="AmberBrush" Color="#F5B041"/>
      <SolidColorBrush x:Key="RedBrush" Color="#E74C3C"/>

      <!-- Fluent text box colours, matched to the app. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#262931"/>
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2B2F38"/>
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#262931"/>
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#363A44"/>
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4A4F5B"/>
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2ECC71"/>
      <SolidColorBrush x:Key="TextControlForeground" Color="#ECEEF2"/>
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#ECEEF2"/>
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#ECEEF2"/>

      <!-- Icons. Close and minimize are drawn at their real 12x12 size (a flat line can't be
           stretched to fit); the rest on a 16x16 grid, scaled to fit. The gear is Material
           Design's "cog" (24x24, Apache-2.0). -->
      <StreamGeometry x:Key="GearIcon">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
      <StreamGeometry x:Key="CloseIcon">M1,1 L11,11 M11,1 L1,11</StreamGeometry>
      <StreamGeometry x:Key="MinimizeIcon">M1,6.5 L11,6.5</StreamGeometry>
      <StreamGeometry x:Key="PauseIcon">M5.5,3 L5.5,13 M10.5,3 L10.5,13</StreamGeometry>
      <StreamGeometry x:Key="PlayIcon">M5,3 L13,8 L5,13 Z</StreamGeometry>
      <StreamGeometry x:Key="StopIcon">M3.5,3.5 L12.5,3.5 L12.5,12.5 L3.5,12.5 Z</StreamGeometry>
      <StreamGeometry x:Key="PowerIcon">M8,1.5 L8,7.5 M4.3,3.6 A6,6 0 1 0 11.7,3.6</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>

    <!-- Shared by all the app's buttons. -->
    <Style Selector="Button.primary, Button.ghost, Button.outline, Button.filled, Button.icon, Button.link">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.primary, Button.ghost, Button.outline, Button.filled">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Green "I'm here", Save, Update. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2ECC71"/>
      <Setter Property="Foreground" Value="#0B2415"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#45D883"/>
      <Setter Property="Foreground" Value="#0B2415"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#27AE60"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2ECC71"/>
      <Setter Property="Foreground" Value="#0B2415"/>
      <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- Quiet text button: Cancel, Close, "Keep the timer running". -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>

    <!-- Outlined Pause (amber) and Stop (red). -->
    <Style Selector="Button.outline">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.outline.amber">
      <Setter Property="BorderBrush" Value="#F5B041"/>
      <Setter Property="Foreground" Value="#F5B041"/>
    </Style>
    <Style Selector="Button.outline.red">
      <Setter Property="BorderBrush" Value="#E74C3C"/>
      <Setter Property="Foreground" Value="#F08A7E"/>
    </Style>
    <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#16FFFFFF"/>
    </Style>
    <Style Selector="Button.outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF"/>
    </Style>
    <Style Selector="Button.outline.amber:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#F5B041"/>
      <Setter Property="Foreground" Value="#F5B041"/>
    </Style>
    <Style Selector="Button.outline.red:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#E74C3C"/>
      <Setter Property="Foreground" Value="#F08A7E"/>
    </Style>
    <Style Selector="Button.outline Path">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- Solid confirmation buttons: amber "Pause the timer", red "Stop and quit". -->
    <Style Selector="Button.filled">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.filled.amber">
      <Setter Property="Background" Value="#F5B041"/>
      <Setter Property="Foreground" Value="#1E1505"/>
    </Style>
    <Style Selector="Button.filled.red">
      <Setter Property="Background" Value="#E74C3C"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.filled.amber:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F7BE60"/>
      <Setter Property="Foreground" Value="#1E1505"/>
    </Style>
    <Style Selector="Button.filled.red:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EB6555"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Title-bar icon buttons. -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <Style Selector="Button.icon Path">
      <Setter Property="Stroke" Value="{StaticResource MutedBrush}"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Stretch" Value="None"/>
    </Style>
    <Style Selector="Button.icon Path.filled">
      <Setter Property="Stroke" Value="{x:Null}"/>
      <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <Style Selector="Button.icon:pointerover Path">
      <Setter Property="Stroke" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="Button.icon:pointerover Path.filled">
      <Setter Property="Stroke" Value="{x:Null}"/>
      <Setter Property="Fill" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Small text button: the version, "Reset to defaults", "Remove the saved token". -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#2ECC71"/>
    </Style>
    <Style Selector="Button.link:pressed">
      <Setter Property="RenderTransform" Value="{x:Null}"/>
    </Style>

    <!-- Segmented choice for the end action. -->
    <Style Selector="RadioButton.segment">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bg" Background="#262931" BorderBrush="#363A44" BorderThickness="1"
                  CornerRadius="8" Height="34" Margin="2,0">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Bg">
      <Setter Property="Background" Value="#1C3A29"/>
      <Setter Property="BorderBrush" Value="#2ECC71"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
  </Application.Styles>
</Application>
